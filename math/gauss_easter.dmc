# Gauss's Easter algorithm (Computus) — Gregorian Easter date for a given year.
# Source: TheAlgorithms/Python other/gauss_easter.py
# Returns the date encoded as month*100 + day (e.g. April 8 -> 408, March 23 -> 323).
# NOTE: leap_day_reinstall_number is a FLOAT (integer/4) in the original, so the
# intermediate sums carry .25-step fractions; the final day is truncated via to_int,
# exactly as Python's int(days_to_add + days_from_phm_to_sunday).

fn gauss_easter(year: i64) -> i64 {
    let yf = to_float(year)

    let metonic_cycle = to_float(year % 19)
    let julian_leap_year = to_float(year % 4)
    let non_leap_year = to_float(year % 7)

    let leap_day_inhibits = floor(yf / 100.0)
    let lunar_orbit_correction = floor((13.0 + 8.0 * leap_day_inhibits) / 25.0)
    let leap_day_reinstall_number = leap_day_inhibits / 4.0

    let secular_moon_shift =
        (15.0 - lunar_orbit_correction + leap_day_inhibits - leap_day_reinstall_number) % 30.0
    let century_starting_point =
        (4.0 + leap_day_inhibits - leap_day_reinstall_number) % 7.0

    # days to be added to March 21
    let days_to_add = (19.0 * metonic_cycle + secular_moon_shift) % 30.0

    # PHM -> Paschal Full Moon
    let days_from_phm_to_sunday =
        (2.0 * julian_leap_year + 4.0 * non_leap_year + 6.0 * days_to_add + century_starting_point) % 7.0

    # The == comparisons in the source are against these float values (whole-valued here).
    let is_29 = days_to_add >= 28.5 && days_to_add < 29.5
    let is_28 = days_to_add >= 27.5 && days_to_add < 28.5
    let sun6 = days_from_phm_to_sunday >= 5.5 && days_from_phm_to_sunday < 6.5

    if is_29 && sun6 {
        419
    } else {
        if is_28 && sun6 {
            418
        } else {
            # datetime(year, 3, 22) + timedelta(days = int(days_to_add + days_from_phm_to_sunday))
            let offset = to_int(days_to_add + days_from_phm_to_sunday)
            let total = 22 + offset
            if total <= 31 {
                300 + total
            } else {
                400 + (total - 31)
            }
        }
    }
}

fn test_2007() -> bool { gauss_easter(2007) == 408 }
fn test_2008() -> bool { gauss_easter(2008) == 323 }
fn test_2020() -> bool { gauss_easter(2020) == 412 }
fn test_2021() -> bool { gauss_easter(2021) == 404 }
fn test_1994() -> bool { gauss_easter(1994) == 328 }
fn test_2000() -> bool { gauss_easter(2000) == 423 }
fn test_2010() -> bool { gauss_easter(2010) == 404 }
fn test_2023() -> bool { gauss_easter(2023) == 409 }
fn test_2032() -> bool { gauss_easter(2032) == 328 }
fn test_2100() -> bool { gauss_easter(2100) == 326 }
