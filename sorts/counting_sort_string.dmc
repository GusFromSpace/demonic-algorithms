# Port of counting_sort_string.py (TheAlgorithms)
# counting_sort over integers, exposed as a string-sorter.
# demoniC: strings index to int codepoints; build output via chr()+concat.

# Counting sort of the codepoints of a string -> sorted string.
# Stable counting sort; range derived from min/max codepoint.
fn counting_sort_string(s: str) -> str {
    let n = len(s)
    if n == 0 { return "" }

    # min/max codepoint
    let !cmin = s[0]
    let !cmax = s[0]
    for i in 0..n {
        let c = s[i]
        if c < cmin { cmin = c }
        if c > cmax { cmax = c }
    }

    let span = cmax + 1 - cmin

    # counting array
    let !counts = forge.zeros[f32, [span]]
    for i in 0..n {
        let idx = s[i] - cmin
        counts[idx] = counts[idx] + 1.0
    }

    # build output by walking the value range in ascending order,
    # emitting each codepoint as many times as it was counted.
    let !out = ""
    for v in 0..span {
        let !k = counts[v] as i64
        while k > 0 {
            out = out + chr(v + cmin)
            k = k - 1
        }
    }
    out
}

# Integer counting sort over a fixed-size tensor of N values.
# Faithful to the Python: min/max range, count, prefix-sum, stable place
# from the end. Returns a sorted [N] tensor.
fn counting_sort[N](a: Tensor[f32, [N]]) -> Tensor[f32, [N]] {
    if N == 0 { return a }

    let !cmin = a[0] as i64
    let !cmax = a[0] as i64
    for i in 0..N {
        let v = a[i] as i64
        if v < cmin { cmin = v }
        if v > cmax { cmax = v }
    }

    let span = cmax + 1 - cmin
    let !counts = forge.zeros[f32, [span]]
    for i in 0..N {
        let idx = (a[i] as i64) - cmin
        counts[idx] = counts[idx] + 1.0
    }
    # prefix sum
    for i in 1..span {
        counts[i] = counts[i] + counts[i - 1]
    }

    let !out = forge.zeros[f32, [N]]
    # stable: walk from the end
    let !i = N - 1
    while i >= 0 {
        let idx = (a[i] as i64) - cmin
        let pos = (counts[idx] as i64) - 1
        out[pos] = a[i]
        counts[idx] = counts[idx] - 1.0
        i = i - 1
    }
    out
}

fn test_counting_sort() -> bool {
    let a = [0.0, 5.0, 3.0, 2.0, 2.0]
    let r = counting_sort(a)
    r[0] == 0.0 && r[1] == 2.0 && r[2] == 2.0 && r[3] == 3.0 && r[4] == 5.0
}

fn test_counting_sort_neg() -> bool {
    let a = [-2.0, -5.0, -45.0]
    let r = counting_sort(a)
    r[0] == -45.0 && r[1] == -5.0 && r[2] == -2.0
}

fn test_counting_sort_string() -> bool {
    counting_sort_string("thisisthestring") == "eghhiiinrsssttt"
}

fn test_counting_sort_string_empty() -> bool {
    counting_sort_string("") == ""
}

fn test_counting_sort_string_single() -> bool {
    counting_sort_string("z") == "z"
}

fn test_counting_sort_string_already() -> bool {
    counting_sort_string("abc") == "abc"
}

fn test_counting_sort_string_rev() -> bool {
    counting_sort_string("dcba") == "abcd"
}

fn test_counting_sort_string_dups() -> bool {
    counting_sort_string("aaa") == "aaa"
}
