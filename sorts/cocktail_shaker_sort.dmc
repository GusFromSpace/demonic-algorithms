# cocktail shaker sort, ported from TheAlgorithms/Python
# operates on an f32 tensor of length n (covers int and float cases)

fn cocktail_shaker_sort[N](!arr: Tensor[f32, [N]], n: i64) -> Tensor[f32, [N]] {
    let !start = 0
    let !end = n - 1
    let !go = true

    while go {
        if start < end {
            let !swapped = false

            # left to right pass
            let !i = start
            while i < end {
                if arr[i] > arr[i + 1] {
                    let tmp = arr[i]
                    arr[i] = arr[i + 1]
                    arr[i + 1] = tmp
                    swapped = true
                }
                i = i + 1
            }

            if swapped == false {
                go = false
            } else {
                end = end - 1

                # right to left pass
                let !j = end
                while j > start {
                    if arr[j] < arr[j - 1] {
                        let tmp2 = arr[j]
                        arr[j] = arr[j - 1]
                        arr[j - 1] = tmp2
                        swapped = true
                    }
                    j = j - 1
                }

                if swapped == false {
                    go = false
                } else {
                    start = start + 1
                }
            }
        } else {
            go = false
        }
    }
    arr
}

fn test_cocktail_ints() -> bool {
    let !a = forge.zeros[f32, [5]]
    a[0] = 4.0  a[1] = 5.0  a[2] = 2.0  a[3] = 1.0  a[4] = 2.0
    let r = cocktail_shaker_sort(a, 5)
    r[0] == 1.0 && r[1] == 2.0 && r[2] == 2.0 && r[3] == 4.0 && r[4] == 5.0
}

fn test_cocktail_negs() -> bool {
    let !a = forge.zeros[f32, [6]]
    a[0] = -4.0  a[1] = 5.0  a[2] = 0.0  a[3] = 1.0  a[4] = 2.0  a[5] = 11.0
    let r = cocktail_shaker_sort(a, 6)
    r[0] == -4.0 && r[1] == 0.0 && r[2] == 1.0 && r[3] == 2.0 && r[4] == 5.0 && r[5] == 11.0
}

fn test_cocktail_floats() -> bool {
    let !a = forge.zeros[f32, [4]]
    a[0] = 0.1  a[1] = -2.4  a[2] = 4.4  a[3] = 2.2
    let r = cocktail_shaker_sort(a, 4)
    let t = 0.0001
    (r[0] - (-2.4)) < t && (-2.4 - r[0]) < t &&
    (r[1] - 0.1) < t && (0.1 - r[1]) < t &&
    (r[2] - 2.2) < t && (2.2 - r[2]) < t &&
    (r[3] - 4.4) < t && (4.4 - r[3]) < t
}

fn test_cocktail_sorted() -> bool {
    let !a = forge.zeros[f32, [5]]
    a[0] = 1.0  a[1] = 2.0  a[2] = 3.0  a[3] = 4.0  a[4] = 5.0
    let r = cocktail_shaker_sort(a, 5)
    r[0] == 1.0 && r[1] == 2.0 && r[2] == 3.0 && r[3] == 4.0 && r[4] == 5.0
}

fn test_cocktail_allneg() -> bool {
    let !a = forge.zeros[f32, [5]]
    a[0] = -4.0  a[1] = -5.0  a[2] = -24.0  a[3] = -7.0  a[4] = -11.0
    let r = cocktail_shaker_sort(a, 5)
    r[0] == -24.0 && r[1] == -11.0 && r[2] == -7.0 && r[3] == -5.0 && r[4] == -4.0
}
