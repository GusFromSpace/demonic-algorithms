# Kadane's algorithm — maximum subarray sum.
# Ported from TheAlgorithms/Python dp_max_subarray_sum.py
# allow_empty: if 1, empty subarrays allowed (result floored at 0); else not.

fn max_subarray_sum(arr, allow_empty: i64) -> f64 {
    let n = list_len(arr)
    if n == 0 {
        return 0.0
    }
    # curr_sum running, max_sum tracked. With allow_empty=0, start max_sum at
    # first achievable; we use a `started` flag to emulate float("-inf").
    let !curr_sum = 0.0
    let !max_sum = 0.0
    let !started = 0
    for i in 0..n {
        let num = to_float(list_get(arr, i))
        # lower bound for restart: 0 if allow_empty else num
        let restart = if allow_empty == 1 { 0.0 } else { num }
        let cand = curr_sum + num
        curr_sum = if restart > cand { restart } else { cand }
        # max_sum = max(max_sum, curr_sum); seed it on first iter when not empty-allowed
        if allow_empty == 1 {
            if curr_sum > max_sum { max_sum = curr_sum }
        } else {
            if started == 0 {
                max_sum = curr_sum
                started = 1
            } else {
                if curr_sum > max_sum { max_sum = curr_sum }
            }
        }
    }
    max_sum
}

fn test_basic() -> bool {
    isclose(max_subarray_sum(list(2.0, 8.0, 9.0), 0), 19.0)
}

fn test_zeros() -> bool {
    isclose(max_subarray_sum(list(0.0, 0.0), 0), 0.0)
}

fn test_mixed_neg() -> bool {
    isclose(max_subarray_sum(list(-1.0, 0.0, 1.0), 0), 1.0)
}

fn test_trailing_neg() -> bool {
    isclose(max_subarray_sum(list(1.0, 2.0, 3.0, 4.0, -2.0), 0), 10.0)
}

fn test_wiki() -> bool {
    isclose(max_subarray_sum(list(-2.0, 1.0, -3.0, 4.0, -1.0, 2.0, 1.0, -5.0, 4.0), 0), 6.0)
}

fn test_two_runs() -> bool {
    isclose(max_subarray_sum(list(2.0, 3.0, -9.0, 8.0, -2.0), 0), 8.0)
}

fn test_all_neg() -> bool {
    isclose(max_subarray_sum(list(-2.0, -3.0, -1.0, -4.0, -6.0), 0), -1.0)
}

fn test_all_neg_empty_allowed() -> bool {
    isclose(max_subarray_sum(list(-2.0, -3.0, -1.0, -4.0, -6.0), 1), 0.0)
}

fn test_empty() -> bool {
    isclose(max_subarray_sum(list(), 0), 0.0)
}
