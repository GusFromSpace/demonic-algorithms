# Edit distance (Levenshtein), bottom-up DP.
# Ported from TheAlgorithms/Python dp_edit_distance.EditDistance.min_dist_bottom_up
# strings indexed as codepoints; dp grid stored flat as [(m+1)*(n+1)].

fn min3(a: i64, b: i64, c: i64) -> i64 {
    let !lo = a
    if b < lo { lo = b }
    if c < lo { lo = c }
    lo
}

fn edit_distance(word1: str, word2: str) -> i64 {
    let m = len(word1)
    let n = len(word2)
    let w = n + 1
    let !dp = forge.zeros[i64, [4096]]
    let !i = 0
    while i <= m {
        let !j = 0
        while j <= n {
            if i == 0 {
                dp[i * w + j] = j
            } else {
                if j == 0 {
                    dp[i * w + j] = i
                } else {
                    if word1[i - 1] == word2[j - 1] {
                        dp[i * w + j] = dp[(i - 1) * w + (j - 1)]
                    } else {
                        let ins = dp[i * w + (j - 1)]
                        let del = dp[(i - 1) * w + j]
                        let rep = dp[(i - 1) * w + (j - 1)]
                        dp[i * w + j] = 1 + min3(ins, del, rep)
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    dp[m * w + n]
}

fn test_edit_distance() -> bool {
    edit_distance("intention", "execution") == 5 &&
    edit_distance("intention", "") == 9 &&
    edit_distance("", "") == 0 &&
    edit_distance("kitten", "sitting") == 3 &&
    edit_distance("abc", "abc") == 0 &&
    edit_distance("", "abc") == 3 &&
    edit_distance("flaw", "lawn") == 2
}
