# Port of dp_subset_generation.subset_combinations (TheAlgorithms/Python)
# Generates n-element combinations of an integer list in lexicographic
# (by-index) order, matching itertools.combinations.
#
# demoniC has no list-of-tuples return type, so we emit the combinations
# FLATTENED into a tensor of size C(r,n)*n: row k holds combination k,
# column c holds the c-th element of that combination. comb_count gives C(r,n).

# binomial coefficient C(r, n) (0 when n > r)
fn comb_count(r: i64, n: i64) -> i64 {
    if n > r { return 0 }
    if n < 0 { return 0 }
    let !k = n
    if k > r - k { k = r - k }
    let !num = 1
    let !i = 0
    while i < k {
        num = num * (r - i)
        num = num / (i + 1)
        i = i + 1
    }
    num
}

# Fill `out` (flat, capacity total*n) with all n-combinations of elements[0..r],
# in lexicographic index order. Returns the number of combinations written.
# total must equal comb_count(r, n) and `out` must be sized total*n (>=1).
fn fill_combinations[CAP](elements: Tensor[i64, [CAP]], r: i64, n: i64,
                          !out: Tensor[i64, [CAP]]) -> i64 {
    let total = comb_count(r, n)
    if total == 0 { return 0 }
    if n == 0 { return 1 }   # one empty combination; nothing written to out

    # idx[0..n] is the current index tuple, starting at 0,1,...,n-1
    let !idx = forge.zeros[i64, [CAP]]
    let !c = 0
    while c < n {
        idx[c] = c
        c = c + 1
    }

    let !written = 0
    let !done = 0
    while done == 0 {
        # emit current combination: out[written*n + c] = elements[idx[c]]
        let !cc = 0
        while cc < n {
            out[written * n + cc] = elements[idx[cc]]
            cc = cc + 1
        }
        written = written + 1

        # advance the odometer: find rightmost i with idx[i] != i + r - n
        let !i = n - 1
        let !found = -1
        while i >= 0 {
            if idx[i] != i + r - n {
                if found == -1 { found = i }
            }
            i = i - 1
        }
        if found == -1 {
            done = 1
        } else {
            idx[found] = idx[found] + 1
            let !k = found + 1
            while k < n {
                idx[k] = idx[k - 1] + 1
                k = k + 1
            }
        }
    }
    written
}

fn test_comb_count() -> bool {
    let a = comb_count(4, 2) == 6
    let b = comb_count(3, 3) == 1
    let c = comb_count(4, 3) == 4
    let d = comb_count(3, 1) == 3
    let e = comb_count(5, 0) == 1
    let f = comb_count(3, 9) == 0    # n > r
    let g = comb_count(5, 2) == 10
    a && b && c && d && e && f && g
}

fn test_fill_2of4() -> bool {
    # elements = [10,20,30,40], n=2 -> 6 combos, lex order
    # [(10,20),(10,30),(10,40),(20,30),(20,40),(30,40)]
    let !el = forge.zeros[i64, [16]]
    el[0] = 10  el[1] = 20  el[2] = 30  el[3] = 40
    let !out = forge.zeros[i64, [16]]
    let w = fill_combinations(el, 4, 2, out)
    let ok_count = w == 6
    let r0 = out[0] == 10 && out[1] == 20
    let r1 = out[2] == 10 && out[3] == 30
    let r2 = out[4] == 10 && out[5] == 40
    let r3 = out[6] == 20 && out[7] == 30
    let r4 = out[8] == 20 && out[9] == 40
    let r5 = out[10] == 30 && out[11] == 40
    ok_count && r0 && r1 && r2 && r3 && r4 && r5
}

fn test_fill_3of4() -> bool {
    # elements = [1,2,3,4], n=3 -> [(1,2,3),(1,2,4),(1,3,4),(2,3,4)]
    let !el = forge.zeros[i64, [16]]
    el[0] = 1  el[1] = 2  el[2] = 3  el[3] = 4
    let !out = forge.zeros[i64, [16]]
    let w = fill_combinations(el, 4, 3, out)
    let ok_count = w == 4
    let r0 = out[0] == 1 && out[1] == 2 && out[2] == 3
    let r1 = out[3] == 1 && out[4] == 2 && out[5] == 4
    let r2 = out[6] == 1 && out[7] == 3 && out[8] == 4
    let r3 = out[9] == 2 && out[10] == 3 && out[11] == 4
    ok_count && r0 && r1 && r2 && r3
}

fn test_fill_full() -> bool {
    # elements = [6,7,8,9], n=4 -> single combo (6,7,8,9)
    let !el = forge.zeros[i64, [8]]
    el[0] = 6  el[1] = 7  el[2] = 8  el[3] = 9
    let !out = forge.zeros[i64, [8]]
    let w = fill_combinations(el, 4, 4, out)
    w == 1 && out[0] == 6 && out[1] == 7 && out[2] == 8 && out[3] == 9
}

fn test_fill_n_gt_r() -> bool {
    # n > r -> 0 combinations
    let !el = forge.zeros[i64, [8]]
    el[0] = 1  el[1] = 2  el[2] = 3
    let !out = forge.zeros[i64, [8]]
    let w = fill_combinations(el, 3, 9, out)
    w == 0
}

fn test_fill_n0() -> bool {
    # n == 0 -> one empty combination
    let !el = forge.zeros[i64, [8]]
    el[0] = 10  el[1] = 20  el[2] = 30
    let !out = forge.zeros[i64, [8]]
    let w = fill_combinations(el, 3, 0, out)
    w == 1
}
